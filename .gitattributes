# .gitattributes — checked in at repo root

# Normalize line endings to LF in the repo; let the OS convert on checkout.
* text=auto eol=lf

# Explicitly mark file types
*.py    text eol=lf
*.sh    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf

# Binary — Git must not try to diff or convert these
*.onnx      binary
*.onnx.json binary
*.wav       binary
*.png       binary
*.svg       text eol=lf

