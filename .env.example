# Copy this file to .env (in the same folder as compose.yaml) to override
# defaults without editing compose.yaml itself. Docker Compose loads .env
# automatically.

# Port the backend listens on and is published on. If you change this,
# config.json's "port" (used for the frontend's default Backend URL and for
# `python main.py` outside Docker) won't automatically match -- update both.
PORT=8000
